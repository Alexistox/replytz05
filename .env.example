# Copy file này thành .env rồi điền giá trị thật.
# Telegram API: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=

# User ID Telegram luôn có quyền admin (nhiều ID cách nhau bằng dấu phẩy)
PERMANENT_ADMIN_USER_IDS=

# Tùy chọn
# TELEGRAM_SESSION_FILE=./telegram.session
# TELEGRAM_SESSION_STRING=
