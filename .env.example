# Copy file này thành .env rồi điền giá trị thật.
# Telegram API: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE_NUMBER=

# User ID Telegram luôn có quyền admin (nhiều ID cách nhau bằng dấu phẩy)
PERMANENT_ADMIN_USER_IDS=

# OpenAI: tách ngân hàng, số tài khoản, tên chủ thẻ + AI chat (nếu AI_PROVIDER=openai)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# AI auto-reply theo chat (mặc định TẮT — bật bằng /ai on trong từng chat)
# AI_PROVIDER=openai|claude|grok
AI_PROVIDER=openai
ANTHROPIC_API_KEY=
XAI_API_KEY=
# AI_MODEL=
# AI_SYSTEM_PROMPT=Bạn là trợ lý ngắn gọn trên Telegram.
# AI_MAX_HISTORY=12

# Control API (ý 2): Cursor/Claude/Grok điều khiển userbot qua HTTP localhost
# Chỉ lắng nghe khi có token. Mặc định 127.0.0.1:3847
CONTROL_API_TOKEN=
# CONTROL_API_HOST=127.0.0.1
# CONTROL_API_PORT=3847

# Tùy chọn
# TELEGRAM_SESSION_FILE=./telegram.session
# TELEGRAM_SESSION_STRING=
# COPYALL_MAX_COLLECT=5000
# COPYALL_MAX_COPY=5000
# BDL_MAX_RANGE=200
# COPY_POLICY_FILTER=1
